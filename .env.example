# Copy to .env and fill in real values for local development.
# Never commit .env.

# Local development can use PostgreSQL; CI overrides this with SQLite.
DATABASE_URL=sqlite:///./test.db

# Leave empty when the ML service is unavailable.
ML_SERVICE_URL=
ML_SERVICE_TIMEOUT=30.0

CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=10